<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/targetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/race_surface_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/race_surface_panel_alt"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/targetNumber"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/race_text_primary"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/race_text_primary"
            android:textStyle="bold"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@id/targetChevron"
            app:layout_constraintStart_toEndOf="@id/targetNumber"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_target_type"
            android:textColor="@color/race_text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetName" />

        <TextView
            android:id="@+id/targetDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:textColor="@color/race_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_target_current"
            android:text="@string/race_deck_current_target"
            android:textColor="@color/light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/targetDistance"
            app:layout_constraintTop_toBottomOf="@id/targetDistance" />

        <ImageView
            android:id="@+id/targetPassedIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/race_deck_target_passed"
            android:src="@drawable/ic_target_passed"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetType" />

        <TextView
            android:id="@+id/targetPassedAt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/race_text_primary"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/targetChevron"
            app:layout_constraintStart_toEndOf="@id/targetPassedIcon"
            app:layout_constraintTop_toTopOf="@id/targetPassedIcon" />

        <TextView
            android:id="@+id/targetUploadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_target_uploaded"
            android:textColor="@color/race_success"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetPassedIcon" />

        <ImageView
            android:id="@+id/targetChevron"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_target_chevron"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
