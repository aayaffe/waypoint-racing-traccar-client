<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/targetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/race_space_4"
    app:cardBackgroundColor="@color/race_surface_panel"
    app:cardCornerRadius="@dimen/race_panel_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/race_surface_panel_alt"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/race_target_row_min"
        android:paddingStart="@dimen/race_space_16"
        android:paddingTop="@dimen/race_space_12"
        android:paddingEnd="@dimen/race_space_12"
        android:paddingBottom="@dimen/race_space_12">

        <TextView
            android:id="@+id/targetNumber"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/race_text_primary"
            android:textSize="@dimen/race_text_target_ordinal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/race_text_primary"
            android:textStyle="bold"
            android:textSize="@dimen/race_text_target_name"
            app:layout_constraintEnd_toStartOf="@id/targetChevron"
            app:layout_constraintStart_toEndOf="@id/targetNumber"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/race_space_4"
            android:background="@drawable/bg_target_type"
            android:textColor="@color/race_text_secondary"
            android:textSize="@dimen/race_text_label"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetName" />

        <TextView
            android:id="@+id/targetDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/race_space_24"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/race_text_primary"
            android:textSize="@dimen/race_text_instrument_secondary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/targetCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/race_space_8"
            android:background="@drawable/bg_target_current"
            android:text="@string/race_deck_current_target"
            android:textColor="@color/race_text_primary"
            android:textSize="@dimen/race_text_target_current"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/targetDistance"
            app:layout_constraintTop_toBottomOf="@id/targetDistance" />

        <ImageView
            android:id="@+id/targetPassedIcon"
            android:layout_width="@dimen/race_icon_target"
            android:layout_height="@dimen/race_icon_target"
            android:layout_marginStart="@dimen/race_space_12"
            android:contentDescription="@string/race_deck_target_passed"
            android:src="@drawable/ic_target_passed"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetType" />

        <TextView
            android:id="@+id/targetPassedAt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/race_space_8"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/race_text_primary"
            android:textSize="@dimen/race_text_target_passed_at"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/targetChevron"
            app:layout_constraintStart_toEndOf="@id/targetPassedIcon"
            app:layout_constraintTop_toTopOf="@id/targetPassedIcon" />

        <TextView
            android:id="@+id/targetUploadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/race_space_4"
            android:background="@drawable/bg_target_uploaded"
            android:textColor="@color/race_success"
            android:textSize="@dimen/race_text_upload_status"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/targetName"
            app:layout_constraintTop_toBottomOf="@id/targetPassedIcon" />

        <ImageView
            android:id="@+id/targetChevron"
            android:layout_width="@dimen/race_icon_target"
            android:layout_height="@dimen/race_icon_target"
            android:contentDescription="@null"
            android:src="@drawable/ic_target_chevron"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
